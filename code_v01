        "jsCode": "// Recorre cada item del input\nconst results = [];\n\nfor (const item of items) {\n  let data = item.json;\n\n  // Si tiene una propiedad `output` que es un string\n  if (typeof data.output === 'string') {\n    let raw = data.output;\n\n    // Elimina los delimitadores ```json ... ```\n    raw = raw.replace(/```json\\s*|\\s*```/g, '');\n\n    try {\n      const parsed = JSON.parse(raw);\n      results.push({ json: parsed });\n    } catch (err) {\n      // Si no se puede parsear, pasa el string original con un warning\n      results.push({ json: { error: 'No se pudo parsear el output como JSON', raw: data.output } });\n    }\n\n  } else {\n    // Si ya es un JSON válido normal, lo pasa directo\n    results.push({ json: data });\n  }\n}\n\nreturn results;\n"
